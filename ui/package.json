{
  "name": "ai-toolkit-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n WORKER,UI \"tsx watch --tsconfig tsconfig.worker.json cron/worker.ts\" \"next dev\"",
    "build": "next build",
    "start": "concurrently -k -n WORKER,UI \"tsx cron/worker.ts\" \"next start --port 8675\"",
    "build_and_start": "npm install && npm run update_db && npm run build && npm run start",
    "lint": "eslint .",
    "update_db": "export DATABASE_URL=\"${DATABASE_URL:-file:../../aitk_db.db}\" && npx prisma generate && npx prisma db push",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,scss}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@headlessui/react": "^2.2.9",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/adapter-better-sqlite3": "^7.2.0",
    "@prisma/client": "^7.3.0",
    "archiver": "^7.0.1",
    "axios": "^1.7.9",
    "better-sqlite3": "^12.0.0",
    "bonjour-service": "^1.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "motion": "^12.34.0",
    "next": "^16.1.0",
    "next-themes": "^0.4.6",
    "node-cache": "^5.1.2",
    "prisma": "^7.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-dropzone": "^14.3.5",
    "react-global-hooks": "^1.3.5",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "systeminformation": "^5.27.11",
    "tsx": "^4.21.0",
    "uuid": "^11.1.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@next/eslint-plugin-next": "^16.1.0",
    "@tailwindcss/postcss": "^4.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/archiver": "^6.0.3",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^25.0.0",
    "postcss": "^8",
    "prettier": "^3.8.0",
    "prettier-basic": "^1.0.0",
    "tailwindcss": "^4.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.55.0",
    "vitest": "^4.0.0"
  }
}
