{
  "name": "ai-toolkit-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n WORKER,UI \"ts-node-dev --project tsconfig.worker.json --respawn --watch cron --transpile-only cron/worker.ts\" \"next dev --turbopack\"",
    "build": "tsc -p tsconfig.worker.json && next build",
    "start": "concurrently -k -n WORKER,UI \"node dist/cron/worker.js\" \"next start --port 8675\"",
    "build_and_start": "npm install && npm run update_db && npm run build && npm run start",
    "lint": "eslint .",
    "update_db": "export DATABASE_URL=\"${DATABASE_URL:-file:../../aitk_db.db}\" && npx prisma generate && npx prisma db push",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,scss}\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@headlessui/react": "^2.2.0",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^6.19.1",
    "archiver": "^7.0.1",
    "axios": "^1.7.9",
    "classnames": "^2.5.1",
    "lucide-react": "^0.475.0",
    "next": "^15.5.9",
    "node-cache": "^5.1.2",
    "prisma": "^6.19.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.5",
    "react-global-hooks": "^1.3.5",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-select": "^5.10.1",
    "recharts": "^3.6.0",
    "sqlite3": "^5.1.7",
    "systeminformation": "^5.27.11",
    "uuid": "^11.1.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@next/eslint-plugin-next": "^15.5.12",
    "@tailwindcss/postcss": "^4.1",
    "@types/archiver": "^6.0.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8",
    "prettier": "^3.5.1",
    "prettier-basic": "^1.0.0",
    "tailwindcss": "^4.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5",
    "typescript-eslint": "^8.55.0"
  },
  "prettier": "prettier-basic"
}
