# Copy to .env and adjust as needed
# Data directory (same as nix run / Docker). All paths below default under this.
# AI_TOOLKIT_UI_DATA="~/.local/share/ai-toolkit"

# Database (Prisma resolves relative to ui/prisma/, so use absolute path)
# DATABASE_URL="file:~/.local/share/ai-toolkit/aitk_db.db"

# Override individual data directories (optional)
# DATASETS_FOLDER="~/.local/share/ai-toolkit/datasets"
# TRAINING_FOLDER="~/.local/share/ai-toolkit/output"
# DATA_ROOT="~/.local/share/ai-toolkit/data"
